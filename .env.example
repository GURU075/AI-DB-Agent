# Required: never commit the real value.
SPRING_AI_OPENAI_API_KEY=replace-with-your-api-key

# The current provider uses an OpenAI-compatible NVIDIA endpoint.
SPRING_AI_OPENAI_BASE_URL=https://integrate.api.nvidia.com
SPRING_AI_OPENAI_MODEL=meta/llama-4-maverick-17b-128e-instruct

# Runtime
SERVER_PORT=8083
DB_AGENT_SESSION_TTL=PT30M
DB_AGENT_OPERATION_TTL=PT10M
DB_AGENT_QUERY_TIMEOUT_SECONDS=30

# Comma-separated exact hosts or wildcard suffixes such as *.internal.example.com.
# The secure default permits databases on this machine only.
DB_AGENT_ALLOWED_HOSTS=localhost,127.0.0.1,::1
